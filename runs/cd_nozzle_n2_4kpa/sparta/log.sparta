SPARTA (24 Sep 2025)
Running on 4 MPI task(s)
# Generated by sparta/setup.py from cd_nozzle_n2_4kpa.toml -- edit the case file, not this.
# DSMC downstream of the coupling plane (xlo), fed by the SU2 state there.
#   mpirun -n N spa_mpi -in in.sparta   ->  log.sparta, flow.<step>.dump, restart.<step>.sparta
# Continue later with in.continue.

seed            12345
dimension       2

# xlo = coupling plane (inflow + outflow), ylo = axis, yhi/xhi = chamber outflow
boundary        o ao p
create_box      -0.03578160602 0.12 0 0.06 -0.5 0.5
Created orthogonal box = (-0.0357816 0 -0.5) to (0.12 0.06 0.5)
# gridcut 0: each rank keeps only its own cells and their neighbours, not a copy of the
# whole grid (the default -1). Needs the clumped assignment that balance_grid rcb gives.
global          gridcut 0.0
read_grid       grid.sparta custom lambda float 0 custom su2_nrho float 0
  67934 grid cells
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (../grid.cpp:473)
  grid cells = 67934
  CPU time = 0.0297373 secs
  read/setup percent = 96.2509 3.74908
balance_grid    rcb cell
Balance grid migrated 51085 cells
  CPU time = 0.0327713 secs
  reassign/sort/migrate/ghost percent = 23.6201 1.38248 36.2262 38.7713

# nozzle wall (coupling plane -> exit) and faceplate, diffuse at the SU2 wall temperature
read_surf       nozzle.surf clip
  332 lines
  clipped to 330 lines
  -0.0357816 0 xlo xhi
  0.00025 0.06 ylo yhi
  0 0 zlo zhi
  1.15895e-07 min line length
  939 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  61987 5008 939 = cells outside/inside/overlapping surfs
  939 = surf cells with 1,2,etc splits
  0.0013588 1.63096e-06 = cell-wise and global flow volume
  CPU time = 0.0432903 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 1.07803 0.531972 3.97394 82.7401 11.676 7.80208 0.00209285
  surf2grid time = 0.0358184 secs
  map/comm1/comm2/comm3/comm4/split percent = 42.7274 1.89039 39.7252 4.09411 1.53535 1.91723
surf_collide    wall diffuse 300.15 1.0
surf_modify     all collide wall

global          weight cell radius
global          fnum 5.734e+16
species         n2.species N2
mixture         gas N2
collide         vss gas n2.vss
timestep        1.044e-09

fix             inflow emit/face/file gas xlo inflow.sparta XLO
stats           2000
stats_style     step cpu np nattempt ncoll
fix             lb balance 4000 1.1 rcb part
restart         50000 restart.*.sparta

# ---- images of the transient hold -------------------------------------------------------
# image.<step>.ppm every 20000 steps: log10 number density per cell, averaged over the
# 100 steps before each image, white = 1e19 /m3 or less, navy = 1e24 /m3 or more.
# PPM because this SPARTA build has no JPEG/PNG; convert with ImageMagick (sparta/README.md).
# zoom: the 2D box is 1 m deep in z and the picture is scaled to that, so zoom fits it to the domain.
compute         img grid all gas nrho
variable        img_lgn grid log(c_img[1]+1e+19)
fix             img ave/grid all 1 100 2000 v_img_lgn
dump            img image all 2000 image.*.ppm type type particle no grid f_img                 size 1600 616 zoom 33 box no 0.0
dump_modify     img pad 7 backcolor white                 cmap grid 19 24 cf 0.0 5 min white 0.25 lightsteelblue 0.5 cornflowerblue 0.75 royalblue max navy

# ---- transient hold: let the jet fill the box before averaging -------------------------
run             499000
